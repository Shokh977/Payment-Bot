# Telegram bot token from @BotFather
BOT_TOKEN=

# Must match PAYMENT_BOT_SECRET in the backend .env
PAYMENT_BOT_SECRET=

# Backend base URL (no trailing slash)
API_BASE_URL=https://api.sahifalab.uz

# Comma-separated Telegram user IDs that receive admin notifications
ADMIN_TELEGRAM_IDS=123456789,987654321

# Redis URL for FSM state storage (optional — falls back to in-memory)
REDIS_URL=redis://localhost:6379/0

# Bunny.net Storage for screenshot uploads (optional — falls back to tg:// file_id)
# Storage zone name (Bunny Dashboard → Storage → your zone name)
BUNNY_STORAGE_ZONE=
# Storage zone password (Bunny Dashboard → Storage → your zone → FTP & API Access → Password)
BUNNY_API_KEY=
# Pull zone URL (Bunny Dashboard → CDN → your pull zone → Hostname)
BUNNY_CDN_URL=https://sahifalab.b-cdn.net
# Storage region — leave default (EU) or use: ny.storage.bunnycdn.com / la / sg / syd
BUNNY_STORAGE_REGION=storage.bunnycdn.com

# Payment card info shown to users
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER= 

# Support channel / deep link shown in messages
SUPPORT_USERNAME=@SLED010
APP_DEEP_LINK=https://sahifalab.uz
